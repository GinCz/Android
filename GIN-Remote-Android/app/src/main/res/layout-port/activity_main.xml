<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- TOP SECTION: Controls & Telemetry -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Branding Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                app:srcCompat="@drawable/ic_launcher" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_title"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="• Шлюз управления"
                android:textColor="@color/text_sub"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Status Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/card_bg"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp">

            <View
                android:id="@+id/viewStatusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/dot_disconnected" />

            <TextView
                android:id="@+id/tvStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_disconnected"
                android:textColor="@color/text_title"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Action Buttons: Connect + Exit in one row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnToggle"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/btn_connect_bg"
                android:focusable="true"
                android:text="@string/btn_connect"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnExit"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="0.45"
                android:background="@drawable/btn_exit_bg"
                android:focusable="true"
                android:text="🚪 Выход"
                android:textColor="#F87171"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Permissions & Feature Buttons -->
        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/btn_version_bg"
            android:focusable="true"
            android:text="🛡️ Управление жестами: Проверка..."
            android:textColor="#38bdf8"
            android:textSize="10.5sp" />

        <Button
            android:id="@+id/btnCapture"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/btn_version_bg"
            android:focusable="true"
            android:text="📸 Трансляция экрана: Запустить"
            android:textColor="#38bdf8"
            android:textSize="10.5sp" />

        <!-- Telemetry Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvDeviceModel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="Модель: Загрузка..."
                android:textColor="@color/text_title"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/tvDeviceOs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="ОС: Android"
                android:textColor="@color/text_title"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/tvDeviceRam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="ОЗУ: Загрузка..."
                android:textColor="@color/text_title"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/tvDeviceCpu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="ЦП: Загрузка..."
                android:textColor="@color/text_title"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/tvDeviceNet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Сеть: Загрузка..."
                android:textColor="@color/text_title"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Version & Update Button -->
        <Button
            android:id="@+id/btnVersion"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/btn_version_bg"
            android:focusable="true"
            android:text="GIN-Remote v017 • Обновить (OK)"
            android:textColor="@color/text_sub"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- BOTTOM SECTION: Log Terminal (Fills remaining height) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="ТЕРМИНАЛ СОБЫТИЙ (92.5.111.49:17000)"
            android:textColor="@color/text_sub"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/scrollLogs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tvLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="1dp"
                android:text="[--:--:--] Инициализация сервиса GIN-Remote v017..."
                android:textColor="@color/text_terminal"
                android:textSize="8sp" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
