<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- LEFT 1/3: Scrollable Compact Control Panel & Telemetry -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Branding: In One Compact Row (Font 2x smaller) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    app:srcCompat="@drawable/ic_launcher" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_title"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="• Шлюз управления"
                    android:textColor="@color/text_sub"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Status Pill (Compact) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/card_bg"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp">

                <View
                    android:id="@+id/viewStatusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/dot_disconnected" />

                <TextView
                    android:id="@+id/tvStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_disconnected"
                    android:textColor="@color/text_title"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Buttons: Connect/Disconnect and Exit in One Line -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnToggle"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_connect_bg"
                    android:focusable="true"
                    android:focusedByDefault="true"
                    android:nextFocusLeft="@id/btnToggle"
                    android:nextFocusUp="@id/btnToggle"
                    android:nextFocusRight="@id/btnExit"
                    android:nextFocusDown="@id/btnAccessibility"
                    android:text="@string/btn_connect"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnExit"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="0.45"
                    android:background="@drawable/btn_exit_bg"
                    android:focusable="true"
                    android:nextFocusLeft="@id/btnToggle"
                    android:nextFocusRight="@id/btnExit"
                    android:nextFocusUp="@id/btnExit"
                    android:nextFocusDown="@id/btnAccessibility"
                    android:text="🚪 Выход"
                    android:textColor="#F87171"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Accessibility Permission Button (Compact) -->
            <Button
                android:id="@+id/btnAccessibility"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_version_bg"
                android:focusable="true"
                android:nextFocusUp="@id/btnToggle"
                android:nextFocusDown="@id/btnCapture"
                android:text="🛡️ Управление жестами: Проверка..."
                android:textColor="#38bdf8"
                android:textSize="10sp" />

            <!-- Screen Capture Permission Button (Compact) -->
            <Button
                android:id="@+id/btnCapture"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_version_bg"
                android:focusable="true"
                android:nextFocusUp="@id/btnAccessibility"
                android:nextFocusDown="@id/btnVersion"
                android:text="📸 Трансляция экрана: Запустить"
                android:textColor="#38bdf8"
                android:textSize="10sp" />

            <!-- Compact Telemetry Card (No Header) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvDeviceModel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="Модель: Загрузка..."
                    android:textColor="@color/text_title"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/tvDeviceOs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="ОС: Android"
                    android:textColor="@color/text_title"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/tvDeviceRam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="ОЗУ: Загрузка..."
                    android:textColor="@color/text_title"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/tvDeviceCpu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="ЦП: Загрузка..."
                    android:textColor="@color/text_title"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/tvDeviceNet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Сеть: Загрузка..."
                    android:textColor="@color/text_title"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Version & Update Button (Compact) -->
            <Button
                android:id="@+id/btnVersion"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_version_bg"
                android:focusable="true"
                android:nextFocusUp="@id/btnAccessibility"
                android:text="GIN-Remote v008 • Обновить (OK)"
                android:textColor="@color/text_sub"
                android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>

    <!-- RIGHT 2/3: Full-Height Detailed Log Terminal -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_weight="2"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="ПОЛНОРАЗМЕРНЫЙ ТЕРМИНАЛ СОБЫТИЙ (92.5.111.49:17000)"
            android:textColor="@color/text_sub"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/scrollLogs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:descendantFocusability="blocksDescendants"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tvLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:fontFamily="monospace"
                android:lineSpacingExtra="1dp"
                android:text="[--:--:--] Инициализация сервиса GIN-Remote v008..."
                android:textColor="@color/text_terminal"
                android:textSize="6.5sp" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
